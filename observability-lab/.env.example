GRAFANA_IMAGE=docker.1panel.live/grafana/grafana:latest
OTEL_IMAGE=docker.1panel.live/otel/opentelemetry-collector-contrib:latest
PROMETHEUS_IMAGE=docker.1panel.live/prom/prometheus:latest
LOKI_IMAGE=docker.1panel.live/grafana/loki:3.2.1
TEMPO_IMAGE=docker.1ms.run/grafana/tempo:2.5.0
PYTHON_BASE_IMAGE=m.daocloud.io/docker.io/library/python:3.12-slim

SUBTOAPI_BASE_URL=http://192.168.20.241:8080
AUDIT_ADMIN_PASSWORD=
AUDIT_HASH_SALT=change-me-in-real-use
AUDIT_CAPTURE_BODY=false
AUDIT_MAX_CAPTURE_CHARS=800
AUDIT_CAPTURE_GUARDRAIL_SNIPPETS=true
AUDIT_GUARDRAIL_SNIPPET_CHARS=1200
GUARDRAILS_ENABLED=true
GUARDRAIL_BLOCK_INPUT=true
GUARDRAIL_BLOCK_OUTPUT=true
GUARDRAIL_BANNED_KEYWORDS=种族
GUARDRAIL_BANNED_KEYWORD_STAGES=output
GUARDRAIL_MAX_STREAM_BYTES=2097152
DLP_ENABLED=true
DLP_BLOCK_INPUT=false
DLP_BLOCK_OUTPUT=true
DLP_MASK_INPUT=true
DLP_MASK_OUTPUT=true
DLP_CAPTURE_SNIPPETS=true
DLP_SNIPPET_CHARS=800

# Optional, USD per 1M tokens. Example:
# MODEL_PRICE_PER_1M_JSON={"my-model":{"input":1.0,"output":3.0}}
